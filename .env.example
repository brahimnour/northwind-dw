# Copy to .env if you use python-dotenv, or set these as real environment
# variables before running the app. Not required for local SQLite testing.

# Set to "true" to run against the local SQLite test database instead of
# SQL Server (useful for developing the Flask app without a live DB).
USE_SQLITE=false

# SQL Server connection (used when USE_SQLITE=false)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=NorthwindDW
DB_DRIVER={ODBC Driver 17 for SQL Server}
